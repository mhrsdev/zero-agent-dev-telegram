# Zero Agent v2 — environment file template.
# Copy to .env and fill in your secrets.

# --- Required ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- LLM Provider ---
# One of: gemini, openai, openrouter, custom
ZERO_ROUTER_PROVIDER=gemini

# The Router API key. For provider=gemini, this is your Gemini API key.
# Format: secret://env/VAR_NAME (Zero resolves it at call time).
ZERO_ROUTER_API_KEY=secret://env/GEMINI_API_KEY

# --- Provider API keys (only the selected one is needed) ---
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Optional ---
ZERO_ROUTER_DEFAULT_MODEL=gemini-2.0-flash
ZERO_LOGGING_LEVEL=info
ZERO_DROP_PENDING_UPDATES=true
