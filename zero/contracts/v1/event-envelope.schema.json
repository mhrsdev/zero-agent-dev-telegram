{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero.dev/contracts/v1/event-envelope.schema.json",
  "title": "Zero v2 Event Envelope",
  "description": "Event delivered from Zero to Platform. T-P.3 contract. Scope mandatory; no free-form fields.",
  "type": "object",
  "required": ["id", "name", "scope", "data", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9]{12,32}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "scope": {
      "type": "object",
      "required": ["mode", "key"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["personal", "normal", "development"]},
        "key": {"type": "string", "maxLength": 256}
      }
    },
    "data": {
      "type": "object",
      "description": "Typed payload. Forbidden keys: raw_input, raw_user_message, raw_secret, raw_content.",
      "not": {
        "required": ["raw_input", "raw_user_message", "raw_secret", "raw_content"]
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
