{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero.dev/contracts/v1/health.schema.json",
  "title": "Zero v2 Health Report",
  "description": "Health report published by Zero to Platform. T-P.3 + T-9.4. Zero never reports 'offline'.",
  "type": "object",
  "required": ["status", "capabilities_hash", "version", "checked_at"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "warning", "critical", "unknown"]
    },
    "capabilities_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of sorted capabilities JSON"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "detail": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
