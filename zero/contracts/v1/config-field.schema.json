{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero.dev/contracts/v1/config-field.schema.json",
  "title": "Zero v2 Config Field Metadata",
  "description": "Per-field metadata exported to Platform. T-P.5. secret fields NEVER have values.",
  "type": "object",
  "required": ["name", "type", "required", "secret"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "type": {
      "type": "string",
      "enum": ["string", "integer", "number", "boolean", "array", "object", "secret_ref"]
    },
    "required": {"type": "boolean"},
    "default": {},
    "secret": {"type": "boolean"},
    "readonly": {"type": "boolean"},
    "advanced": {"type": "boolean"},
    "restart_required": {"type": "boolean"},
    "scope": {
      "type": "string",
      "enum": ["global", "personal", "project", "workspace"]
    },
    "description": {"type": "string"},
    "validation": {"type": ["string", "null"]},
    "configured": {
      "type": ["boolean", "null"],
      "description": "Only for secret fields — whether the referenced secret exists"
    },
    "last_rotated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Only for secret fields — when the underlying secret was last rotated"
    }
  }
}
